{
  "expo": {
    "name": "ClockIn Employee",
    "slug": "clockin",
    "version": "2.3.3",
    "entryPoint": "./index.ts",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.websys.clockin",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "ClockIn uses your location to verify you are at the restaurant when clocking in.",
        "NSCameraUsageDescription": "ClockIn uses the camera to capture a face photo when your employer requires punch verification."
      }
    },
    "android": {
      "icon": "./assets/icon.png",
      "package": "com.websys.clockinemployee",
      "googleServicesFile": "./google-services.json",
      "versionCode": 3,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "notification": {
      "color": "#3a7bd5"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "ClockIn uses the camera to capture a face photo when your employer requires punch verification."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "209e8a2c-2339-46e4-9e58-90325a80c852"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/209e8a2c-2339-46e4-9e58-90325a80c852"
    }
  }
}
