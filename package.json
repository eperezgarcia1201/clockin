{
  "name": "clockin-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run start:dev",
    "dev:mobile": "npm --workspace apps/mobile run start",
    "dev:mobile-admin": "npm --workspace apps/mobile-admin run start -- --port 8083",
    "check:lines": "node ./scripts/check-max-lines.mjs --config ./guardrails.config.json",
    "check:no-direct-fetch": "node ./scripts/check-no-direct-fetch.mjs --config ./guardrails.config.json",
    "validate:refactor-chunk": "npm --workspace apps/api run build && npm --workspace apps/web run build && npx tsc -p apps/mobile/tsconfig.json --noEmit && npx tsc -p apps/mobile-admin/tsconfig.json --noEmit && npm run check:lines && npm run check:no-direct-fetch && npm --workspace apps/api run test -- --runInBand",
    "check:icons": "bash ./scripts/check-unique-app-icons.sh",
    "check:review-access": "bash ./scripts/verify-review-access.sh",
    "check:review-access:admin": "bash ./scripts/verify-admin-review-access.sh",
    "sync:store-icons": "bash ./scripts/sync-store-icons.sh",
    "lint": "npm --workspace apps/web run lint && npm --workspace apps/api run lint",
    "format": "prettier -w .",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "expo": "~54.0.33",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5"
  },
  "overrides": {
    "@types/react": "19.1.17",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "version": "1.0.0"
}
